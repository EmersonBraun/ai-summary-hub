# Algolia DocSearch (optional). Used by docusaurus.config.ts and CI deploy.
# Copy this file to .env in the repo root — docusaurus.config.ts loads it via dotenv on start/build.
# Without both values set, the search bar is omitted (avoids Algolia "Unreachable hosts").
# Apply for DocSearch: https://docsearch.algolia.com/apply/
# Production: also set GitHub Actions secrets ALGOLIA_APP_ID and ALGOLIA_API_KEY.
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
