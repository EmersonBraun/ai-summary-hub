{
  "name": "ai-summary-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "prestart": "node scripts/generate-doc-tags.mjs",
    "start": "docusaurus start",
    "prebuild": "node scripts/generate-doc-tags.mjs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "USE_SSH=true docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc",
    "lint": "eslint .",
    "validate:frontmatter": "node scripts/validate-frontmatter.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:markdown": "markdownlint-cli2",
    "validate": "npm run validate:frontmatter && npm run validate:links && npm run validate:markdown",
    "i18n:audit-docs": "node scripts/audit-i18n-docs-english-leaks.mjs",
    "i18n:generate-code": "node scripts/generate-locale-code-json.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@docusaurus/theme-mermaid": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "3.10.1",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.2.16",
    "eslint": "^10.4.1",
    "glob": "^13.0.6",
    "gray-matter": "^4.0.3",
    "markdownlint-cli2": "^0.22.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
